# WiFi Billing System - Backend Environment Configuration
# Copy this file to .env (in this backend/ folder) and fill in your values.
# Everything is optional for local development.

# Your business, shown to customers
BUSINESS_NAME=My WiFi
# Phone or email shown on the portal, login page and SMS
SUPPORT_CONTACT=
# Public address of the customer portal (frontend), e.g. https://wifi.example.com
PORTAL_URL=
# Public address of this API including /api, e.g. https://api.example.com/api
# (leave blank to use the address the dashboard is opened from)
PUBLIC_API_URL=
# Your hotspot's login page, e.g. http://wifi.login - shown as a "Connect" button after payment
HOTSPOT_LOGIN_URL=

# First admin account, used by init_db.py (otherwise it asks you)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Built-in RADIUS server (UDP 1812/1813). Any router, AP controller or firewall
# with a RADIUS hotspot/captive portal logs customers in through it. Add routers
# in the dashboard's Routers tab. Starts together with billing_system_backend.py.
RADIUS_ENABLED=1
# Address routers use to reach this server (LAN IP or public IP / domain)
RADIUS_PUBLIC_HOST=
RADIUS_AUTH_PORT=1812
RADIUS_ACCT_PORT=1813
RADIUS_INTERIM_INTERVAL=300

# MikroTik-only direct sync, an alternative to RADIUS for hosts without UDP (e.g. Render)
#   off  - not used (default; use RADIUS)
#   pull - the router downloads voucher changes every ROUTER_SYNC_INTERVAL seconds.
#   api  - the backend logs in to the router (RouterOS API, port 8728) and pushes changes.
ROUTER_MODE=off
ROUTER_SYNC_INTERVAL=20
# Optional; derived from SECRET_KEY when blank
ROUTER_SYNC_KEY=
# api mode only. Create a dedicated router user with the "write" and "api" policies.
MIKROTIK_HOST=
MIKROTIK_PORT=8728
MIKROTIK_USER=
MIKROTIK_PASSWORD=

# Database. Leave unset to use a local SQLite file (backend/wifi_billing.db).
# DATABASE_URL=postgresql://user:password@localhost:5432/wifi_billing

# Flask. In production SECRET_KEY is required:
#   python -c "import secrets; print(secrets.token_hex(32))"
FLASK_ENV=development
SECRET_KEY=
JWT_EXPIRY_HOURS=12
# Comma separated list of allowed frontend origins, or *
CORS_ORIGINS=*
# Used to group daily revenue by local day (Kenya = 3)
TIMEZONE_OFFSET_HOURS=3

# M-Pesa (Daraja). If the key, secret or passkey is missing the backend runs in
# MOCK mode for local testing: no real prompt is sent and payments succeed after
# MPESA_MOCK_DELAY seconds. With FLASK_ENV=production, missing keys disable
# payments instead (no free vouchers). MPESA_MODE=mock|live forces a mode.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
# Sandbox passkey for shortcode 174379 (public, from the Daraja docs):
#   bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
MPESA_PASSKEY=
# Use CustomerBuyGoodsOnline for a till number
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
# Must be a public HTTPS URL Safaricom can reach (e.g. an ngrok tunnel locally).
# If unreachable, the backend falls back to polling Daraja's STK query API.
MPESA_CALLBACK_URL=https://your-domain.com/api/mpesa/callback
# Optional shared secret appended to the callback URL as ?token=...
MPESA_CALLBACK_TOKEN=
MPESA_MOCK_DELAY=8

# Server
PORT=5000
HOST=0.0.0.0

# SMS via Africa's Talking (https://africastalking.com). Leave blank to only log
# messages; the voucher code is always shown on screen after payment anyway.
# Use AT_USERNAME=sandbox with your sandbox API key for testing.
AT_USERNAME=
AT_API_KEY=
# Optional registered sender ID / short code
AT_SENDER_ID=

# Built-in gateway (docker compose --profile gateway): this server is the hotspot,
# for routers without one (e.g. Tenda). See "Built-in gateway" in the README.
# HOTSPOT_LOGIN_URL=http://192.168.0.10:8080/login
GATEWAY_FREE_MACS=
# GATEWAY_INTERFACE=eth0
# GATEWAY_DHCP_RANGE=192.168.0.50,192.168.0.250
# GATEWAY_DNS=8.8.8.8,1.1.1.1
